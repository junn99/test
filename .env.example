# Application Settings
APP_NAME="Email Assistant Agent"
DEBUG=false

# LLM Settings (Choose one or both)
LLM_PROVIDER=openai  # openai or anthropic
OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
LLM_MODEL=gpt-4-turbo-preview
LLM_TEMPERATURE=0.7
MAX_TOKENS=2000

# Gmail API Settings
# Download credentials.json from Google Cloud Console
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Outlook Settings (Optional)
# OUTLOOK_CLIENT_ID=your_outlook_client_id
# OUTLOOK_CLIENT_SECRET=your_outlook_client_secret
# OUTLOOK_TENANT_ID=your_outlook_tenant_id

# Email Settings
DEFAULT_EMAIL_PROVIDER=gmail
CHECK_INTERVAL_SECONDS=60
MAX_EMAILS_PER_FETCH=50

# Database Settings
DATABASE_URL=sqlite:///./email_assistant.db

# Redis Settings (Optional - for advanced caching)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
USE_REDIS=false

# Logging
LOG_LEVEL=INFO
LOG_FILE=email_assistant.log
