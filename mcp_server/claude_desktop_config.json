{
  "mcpServers": {
    "notion-knowledge-agent": {
      "command": "python",
      "args": [
        "/absolute/path/to/notion-knowledge-agent/mcp_server/server.py"
      ],
      "env": {
        "NOTION_API_KEY": "your_notion_api_key_here",
        "ANTHROPIC_API_KEY": "your_anthropic_api_key_here"
      }
    }
  }
}
